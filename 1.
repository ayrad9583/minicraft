      if (shift) { var left = addItem(st.id, st.n); if (left === 0) F.s[2] = null; else st.n = left; }
      else if (!cursor) { cursor = st; F.s[2] = null; }
      else if (cursor.id === st.id && cursor.n + st.n <= IT[st.id].max) { cursor.n += st.n; F.s[2] = null; }
    }
  }
  function quickMove(i) {
    var s = inv[i]; if (!s) return;
    var from = i < 9 ? 9 : 0, to = i < 9 ? 36 : 9, m = IT[s.id].max, j;
    if (m > 1) for (j = from; j < to && s.n > 0; j++) { var t = inv[j]; if (t && t.id === s.id && t.n < m) { var a = Math.min(m - t.n, s.n); t.n += a; s.n -= a; } }
    if (s.n <= 0) { inv[i] = null; return; }
    for (j = from; j < to; j++) if (!inv[j]) { inv[j] = s; inv[i] = null; return; }
  }
  function slotAct(g, i, btn, shift) {
    if (g === "pal") { var id = PAL[i]; cursor = newStack(id, btn === 2 ? 1 : IT[id].max); return; }
    if (g === "trash") { cursor = null; return; }
    if (g === "out" || (g === "fur" && i === 2)) { takeOutput(g, i, shift); return; }
    var s = getSlot(g, i);
    if (shift && g === "inv") { quickMove(i); return; }
    if (g === "fur" && cursor && !canPlaceFur(i, cursor)) return;
    var max = s ? IT[s.id].max : 64;
    if (btn === 0) {
      if (!cursor) { cursor = s; setSlot(g, i, null); }
      else if (!s) { setSlot(g, i, cursor); cursor = null; }
      else if (s.id === cursor.id && max > 1) { var a = Math.min(max - s.n, cursor.n); s.n += a; cursor.n -= a; if (!cursor.n) cursor = null; }
      else { setSlot(g, i, cursor); cursor = s; }
    } else if (btn === 2) {
      if (!cursor) { if (s) { var h = Math.ceil(s.n / 2); cursor = { id: s.id, n: h, d: s.d }; s.n -= h; if (!s.n) setSlot(g, i, null); } }
      else if (!s) { setSlot(g, i, { id: cursor.id, n: 1, d: cursor.d }); cursor.n--; if (!cursor.n) cursor = null; }
      else if (s.id === cursor.id && s.n < max) { s.n++; cursor.n--; if (!cursor.n) cursor = null; }
      else { setSlot(g, i, cursor); cursor = s; }
    }
  }
  invEl.addEventListener("mousedown", function (e) {
    e.preventDefault();
    var el = e.target.closest ? e.target.closest(".slot") : null;
    if (!el || !el.dataset.g || !ui) { if (e.target === invEl && cursor) { dropItem(cursor.id, cursor.n, player.x, player.y + 1.2, player.z); cursor = null; renderUI(); } return; }
    slotAct(el.dataset.g, +el.dataset.i, e.button, e.shiftKey);
    computeOut(); renderHotbar(); renderUI(); showTip(el);
  });
  invEl.addEventListener("contextmenu", function (e) { e.preventDefault(); });
  function showTip(el) {
    var s = el && el.dataset && el.dataset.g ? getSlot(el.dataset.g, +el.dataset.i) : null;
    if (!s || !ui || cursor) { tipEl.hidden = true; return; }
    tipEl.textContent = itemName(s.id) + (s.d != null ? "  (" + s.d + "/" + IT[s.id].dur + ")" : "");
    tipEl.hidden = false; tipEl.style.left = (mouseX + 14) + "px"; tipEl.style.top = (mouseY - 28) + "px";
  }
  window.addEventListener("mousemove", function (e) {
    mouseX = e.clientX; mouseY = e.clientY;
    if (!uiOpen) return;
    updateCursorPos();
    showTip(e.target.closest ? e.target.closest(".slot") : null);
  });

  /* ---------- Fours ---------- */
  var furUiT = 0;
  function updateFurnaces(dt) {
    for (var k in furnaces) {
      var F = furnaces[k], inp = F.s[0], out = F.s[2];
      var can = inp && SMELT[inp.id] !== undefined && (!out || (out.id === SMELT[inp.id] && out.n < IT[out.id].max));
      if (F.burn > 0) F.burn -= dt;
      if (can && F.burn <= 0 && F.s[1] && FUEL[F.s[1].id]) { F.burnMax = F.burn = FUEL[F.s[1].id]; F.s[1].n--; if (!F.s[1].n) F.s[1] = null; }
      if (can && F.burn > 0) {
        F.prog += dt;
        if (F.prog >= 10) { F.prog = 0; if (out) out.n++; else F.s[2] = newStack(SMELT[inp.id], 1); inp.n--; if (!inp.n) F.s[0] = null; }
      } else F.prog = Math.max(0, F.prog - dt * 2);
    }
    if (ui && ui.kind === "furnace") {
      var G = getF(); ui.arrow.style.width = (G.prog / 10 * 100) + "%";
      ui.flame.style.height = (G.burn > 0 && G.burnMax ? Math.min(100, G.burn / G.burnMax * 100) : 0) + "%";
      furUiT -= dt; if (furUiT <= 0) { furUiT = 0.3; renderUI(); }
    }
  }
  function spillFurnace(key, x, y, z) {
    var F = furnaces[key]; if (!F) return;
    F.s.forEach(function (s) { if (s) dropItem(s.id, s.n, x + 0.5, y + 0.5, z + 0.5); });
    delete furnaces[key];
  }

  /* ---------- Chat et commandes ---------- */
  var chatEl = document.getElementById("chat"), chatIn = document.getElementById("chatin");
  function say(text) {
    var d = document.createElement("div"); d.textContent = text; chatEl.appendChild(d);
    while (chatEl.children.length > 9) chatEl.removeChild(chatEl.firstChild);
    setTimeout(function () { d.style.opacity = "0"; setTimeout(function () { if (d.parentNode) d.parentNode.removeChild(d); }, 1000); }, 8000);
  }
  function openChat(pre) {
    if (chatOpen) return;
    chatOpen = true; lmb = rmb = false; for (var k in keys) keys[k] = false;
    try { if (document.pointerLockElement) document.exitPointerLock(); } catch (e) {}
    chatIn.hidden = false; chatIn.value = pre || ""; chatIn.focus();
  }
  function closeChat() { chatOpen = false; chatIn.hidden = true; chatIn.blur(); if (playing) tryLock(); canvas.focus(); }
  chatIn.addEventListener("keydown", function (e) {
    e.stopPropagation();
    if (e.key === "Enter") { var v = chatIn.value.trim(); closeChat(); if (v) runCommand(v); }
    else if (e.key === "Escape") closeChat();
  });
  function num(v, cur) { if (v == null) return cur; if (v.charAt(0) === "~") return cur + (+v.slice(1) || 0); return +v; }
  function runCommand(s) {
    if (s.charAt(0) !== "/") { say("<Toi> " + s); return; }
    var a = s.slice(1).trim().split(/\s+/), c = a[0].toLowerCase();
    switch (c) {
      case "help": say("/gamemode survie|creatif   /time set jour|nuit|midi|minuit|<ticks>   /give <objet> [nombre]"); say("/tp x y z   /kill   /heal   /summon <mob>   /clear   /items   /seed"); break;
      case "gamemode": case "gm": {
        var v = (a[1] || "").toLowerCase();
        if (v === "s" || v === "survie" || v === "survival" || v === "0") { setMode("survie"); say("Mode de jeu: Survie"); }
        else if (v === "c" || v === "creatif" || v === "créatif" || v === "creative" || v === "1") { setMode("creatif"); say("Mode de jeu: Créatif"); }
        else say("Usage: /gamemode survie|creatif");
        break;
      }
      case "time": {
        if (a[1] !== "set" || !a[2]) { say("Usage: /time set jour|nuit|midi|minuit|<ticks>"); break; }
        var w = a[2].toLowerCase(), tk = { jour: 1000, day: 1000, midi: 6000, noon: 6000, nuit: 16000, night: 16000, minuit: 18000, midnight: 18000 }[w];
        if (tk == null) tk = +w;
        if (isNaN(tk)) { say("Valeur invalide"); break; }
        dayT = ((((tk - 6000) / 24000) % 1) + 1) % 1 * DAY; say("Heure réglée."); break;
      }
      case "give": {
        var id = KEYS[(a[1] || "").toLowerCase()], n = Math.max(1, Math.min(2304, +a[2] || 1));
        if (!id) { say("Objet inconnu. Tape /items pour la liste."); break; }
        var left = IT[id].max === 1 ? 0 : 0, given = 0;
        while (n > 0) { var q = Math.min(IT[id].max, n); left = addItem(id, q); given += q - left; n -= q; if (left) break; }
        say("Donné " + given + " x " + itemName(id)); break;
      }
      case "items": {
        var line = "", keysL = Object.keys(KEYS);
        keysL.forEach(function (k) { if (line.length + k.length > 70) { say(line); line = ""; } line += k + ", "; });
        if (line) say(line); break;
      }
      case "tp": {
        var tx = num(a[1], player.x), ty = num(a[2], player.y), tz = num(a[3], player.z);
        if (isNaN(tx) || isNaN(ty) || isNaN(tz)) { say("Usage: /tp x y z"); break; }
        player.x = Math.max(1, Math.min(W - 2, tx)); player.y = Math.max(1, Math.min(H + 20, ty)); player.z = Math.max(1, Math.min(D - 2, tz)); player.vy = 0; player.peakY = player.y;
        say("Téléporté."); break;
      }
      case "kill": say("Aïe."); die(); break;
      case "heal": player.hp = 20; player.food = 20; drawStats(); say("Soigné."); break;
      case "clear": inv.fill(null); invChanged(); say("Inventaire vidé."); break;
      case "seed": say("Graine: " + seed); break;
      case "summon": {
        var ty2 = (a[1] || "").toLowerCase();
        if (!MOBS[ty2]) { say("Mobs: " + Object.keys(MOBS).join(", ")); break; }
        camera.getWorldDirection(dirV);
        var sx = Math.max(2, Math.min(W - 3, player.x + dirV.x * 4)), sz = Math.max(2, Math.min(D - 3, player.z + dirV.z * 4));
        spawnMob(ty2, sx, surfaceY(Math.floor(sx), Math.floor(sz)) + 0.02, sz); say(MOBS[ty2].name + " invoqué."); break;
      }
      default: say("Commande inconnue. Tape /help.");
    }
  }

  /* ---------- Mode de jeu et écran d'accueil ---------- */
  var modeBtns = Array.prototype.slice.call(document.querySelectorAll(".mode"));
  var modeHelp = document.getElementById("modehelp");
  var HELP = { creatif: "Blocs illimités, vol (Espace 2 fois), aucun danger. E ouvre l'inventaire créatif.", survie: "Casse pour récolter, fabrique des outils, mange. La nuit, des monstres attaquent." };
  function setMode(m, quiet) {
    mode = m;
    statsEl.style.visibility = m === "survie" ? "visible" : "hidden";
    if (m === "survie") player.fly = false;
    else { clearHostiles(); player.hp = 20; player.food = 20; player.air = 10; }
    modeBtns.forEach(function (b) { var on = b.getAttribute("data-mode") === m; b.classList.toggle("on", on); b.setAttribute("aria-checked", on ? "true" : "false"); });
    modeHelp.textContent = HELP[m];
    if (uiOpen) closeUI(false);
    drawStats(); renderHotbar();
    if (!quiet) persist(false);
  }
  modeBtns.forEach(function (b) { b.addEventListener("click", function () { setMode(b.getAttribute("data-mode")); }); });

  /* ================= SAUVEGARDE ET BOUCLE PRINCIPALE ================= */
  var saveTimer = 0;
  function snapshot() {
    return { seed: seed, edits: edits, mode: mode, inv: inv, sel: sel, hp: player.hp, food: player.food, dayT: dayT,
      pos: [player.x, player.y, player.z], yaw: player.yaw, pitch: player.pitch, furnaces: furnaces };
  }
  function persist(now) {
    clearTimeout(saveTimer);
    var go = function () { try { localStorage.setItem(SAVE_KEY, JSON.stringify(snapshot())); } catch (e) {} };
    if (now) go(); else saveTimer = setTimeout(go, 800);
  }
  window.addEventListener("beforeunload", function () { persist(true); });
  document.addEventListener("visibilitychange", function () { if (document.hidden) persist(true); });

  var STARTER = [GRASS, DIRT, STONE, COBBLE, PLANKS, LOG, GLASS, CRAFT, FURNACE];
  function giveStarter() { inv.fill(null); STARTER.forEach(function (id, i) { inv[i] = newStack(id, 64); }); }
  function isStarter() {
    for (var i = 0; i < 36; i++) {
      var s = inv[i];
      if (i < 9) { if (!s || s.id !== STARTER[i] || s.n !== 64) return false; } else if (s) return false;
    }
    return true;
  }
  var baseSetMode = setMode;
  setMode = function (m, quiet) {
    if (m === "survie" && isStarter()) inv.fill(null);
    baseSetMode(m, quiet);
    if (m === "creatif" && inv.every(function (s) { return !s; })) giveStarter();
    renderHotbar();
  };

  function loadState() {
    if (!saveData) return false;
    try {
      if (Array.isArray(saveData.inv)) for (var i = 0; i < 36; i++) { var s = saveData.inv[i]; inv[i] = (s && IT[s.id] && s.n > 0) ? s : null; }
      sel = Math.max(0, Math.min(8, saveData.sel | 0));
      if (typeof saveData.hp === "number") player.hp = saveData.hp;
      if (typeof saveData.food === "number") player.food = saveData.food;
      if (typeof saveData.dayT === "number") dayT = saveData.dayT;
      if (saveData.furnaces) furnaces = saveData.furnaces;
      if (saveData.pos && saveData.pos.length === 3) {
        player.x = saveData.pos[0]; player.y = saveData.pos[1]; player.z = saveData.pos[2];
        player.yaw = saveData.yaw || 0; player.pitch = saveData.pitch || 0; player.peakY = player.y;
        return true;
      }
    } catch (e) {}
    return false;
  }

  document.getElementById("play").addEventListener("click", startPlay);
  document.getElementById("fresh").addEventListener("click", function () {
    seed = Math.floor(Math.random() * 1e6); edits = {}; furnaces = {};
    inv.fill(null); clearAllMobs();
    drops.forEach(function (o) { scene.remove(o.spr); }); drops.length = 0;
    generate(); buildAll(); spawn(); spawnInitialMobs();
    player.hp = 20; player.food = 20; player.air = 10; dayT = DAY * 0.04;
    if (mode === "creatif") giveStarter();
    renderHotbar(); drawStats(); persist(true);
    msgEl.textContent = "Nouveau monde créé.";
  });

  var last = performance.now(), infoT = 0, autoT = 0, fpsFrames = 0, fpsT = 0, fps = 60;
  function pad2(n) { return (n < 10 ? "0" : "") + n; }
  function frame(now) {
    requestAnimationFrame(frame);
    var dt = Math.min((now - last) / 1000, 0.1); last = now;
    if (playing && !dead) {
      if (dragging && !locked && dragDist < 6 && !lmb && !rmb && now - dragT > 160) onDown(dragBtn);
      var n = Math.max(1, Math.ceil(dt / 0.016));
      for (var i = 0; i < n; i++) stepPlayer(dt / n);
      updateMining(dt); survive(dt); dayT += dt; updateMobs(dt); updateFurnaces(dt);
      autoT += dt; if (autoT > 15) { autoT = 0; persist(false); }
    }
    flushDirty(3);
    camera.position.set(player.x, player.y + (player.sneak ? 1.45 : 1.62), player.z);
    camera.rotation.set(player.pitch, player.yaw, 0);
    camUnder = waterAt(camera.position.x, camera.position.y, camera.position.z);
    document.getElementById("water").hidden = !camUnder;
    var tf = 70 + (player.sprint ? 8 : 0);
    fovCur += (tf - fovCur) * Math.min(1, dt * 8);
    if (Math.abs(camera.fov - fovCur) > 0.05) { camera.fov = fovCur; camera.updateProjectionMatrix(); }
    applySky();

    var t = (playing && !uiOpen && !dead) ? targetBlock() : null;
    if (t) { hl.visible = true; hl.position.set(t.x + 0.5, t.y + 0.5, t.z + 0.5); } else hl.visible = false;

    fpsFrames++; fpsT += dt;
    if (fpsT >= 0.5) { fps = Math.round(fpsFrames / fpsT); fpsFrames = 0; fpsT = 0; }
    if (debugOn) {
      infoT += dt;
      if (infoT > 0.2) {
        infoT = 0;
        var p = (dayT / DAY) % 1, hh = Math.floor(((p * 24 + 12) % 24)), mm = Math.floor(((p * 24 + 12) % 1) * 60);
        document.getElementById("info").textContent =
          "Mini Craft   " + fps + " FPS\n" +
          "XYZ: " + player.x.toFixed(2) + " / " + player.y.toFixed(2) + " / " + player.z.toFixed(2) + "\n" +
          "Bloc visé: " + (t ? BL[t.id].name + " (" + t.x + " " + t.y + " " + t.z + ")" : "aucun") + "\n" +
          "Chunk: " + (player.x >> 4) + " " + (player.z >> 4) + "   Cap: " + Math.round(((-player.yaw * 180 / Math.PI) % 360 + 360) % 360) + "°\n" +
          "Heure: " + pad2(hh) + ":" + pad2(mm) + "   Lumière: " + light.toFixed(2) + "\n" +
          "Mobs: " + mobs.length + "   Objets: " + drops.length + "   Flèches: " + arrows.length + "\n" +
          "Mode: " + (mode === "survie" ? "Survie" : "Créatif") + (player.fly ? " (vol)" : "");
      }
    }
    renderer.render(scene, camera);
  }

  /* ---------- Démarrage ---------- */
  generate();
  buildAll();
  var hadPos = loadState();
  if (!hadPos) spawn();
  spawnInitialMobs();
  setMode(mode, true);
  if (!saveData && mode === "creatif") giveStarter();
  renderHotbar(); drawStats(); updateHint(); resize(); showItemName();
  requestAnimationFrame(frame);
  window.__mc = { player: player, inv: inv, get mode() { return mode; }, mobs: mobs, runCommand: runCommand, openUI: openUI, closeUI: closeUI, startPlay: startPlay, camera: camera, rayBox: rayBox, raycast: raycast, tryAttack: tryAttack, leftPress: leftPress, iconURL: iconURL, IT: IT, BL: BL, atlasCanvas: atlasCanvas, blocks: blocks, edits: edits, getF: function () { return furnaces; }, get dead() { return dead; }, get light() { return light; }, get playing() { return playing; }, drops: drops, arrows: arrows, spawnMob: spawnMob, get uiOpen() { return uiOpen; } };

})();
</script>
