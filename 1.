<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mini Craft</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;700&display=swap" rel="stylesheet">
<style>
  /* Concept: plein écran 3D façon Minecraft; HUD (hotbar, coeurs, faim), fenêtres d'inventaire grises à relief. */
  :root {
    --sky: #8fc6f0;
    --panel: #c6c6c6;
    --slotbg: #8b8b8b;
    --ink: #e9f1f7;
    --ink-dim: #9db3c4;
    --txt: #404040;
    --gold: #ffcf4a;
    --grass: #5aa63c;
    --night: #14202b;
    --line: #2c4256;
    --slot: clamp(34px, 9vw, 46px);
    --k: 2;
    --font-display: "Pixelify Sans", ui-monospace, "Courier New", monospace;
    --font-data: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color-scheme: dark;
  }
  html, body { height: 100%; }
  body { margin: 0; background: var(--sky); color: var(--ink); font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; overflow: hidden; user-select: none; -webkit-user-select: none; }
  #app { position: relative; width: 100%; height: 100%; overflow: hidden; }
  canvas#view { display: block; width: 100%; height: 100%; outline: none; cursor: crosshair; }
  .hud { position: absolute; pointer-events: none; }
  [hidden] { display: none !important; }

  #cross { left: 50%; top: 50%; width: 22px; height: 22px; transform: translate(-50%, -50%); }
  #cross::before, #cross::after { content: ""; position: absolute; background: #fff; mix-blend-mode: difference; }
  #cross::before { left: 10px; top: 0; width: 2px; height: 22px; }
  #cross::after { left: 0; top: 10px; width: 22px; height: 2px; }

  #info { left: 12px; top: calc(10px + env(safe-area-inset-top, 0px)); font: 12px/1.5 var(--font-data); background: rgba(0,0,0,.45); padding: 6px 10px; white-space: pre; font-variant-numeric: tabular-nums; }
  #hint { right: 12px; top: calc(10px + env(safe-area-inset-top, 0px)); font-size: 12px; background: rgba(0,0,0,.45); padding: 5px 9px; max-width: min(55vw, 300px); text-align: right; color: var(--ink-dim); }

  #bottom { position: absolute; left: 50%; transform: translateX(-50%); bottom: calc(10px + env(safe-area-inset-bottom, 0px)); display: flex; flex-direction: column; gap: 4px; width: calc(var(--slot) * 9 + 8px); pointer-events: none; }
  #itemname { height: 20px; text-align: center; font: 700 16px var(--font-display); text-shadow: 0 2px 0 rgba(0,0,0,.6); transition: opacity .5s; }
  #stats { display: flex; justify-content: space-between; align-items: flex-end; }
  #stats canvas { image-rendering: pixelated; height: calc(9px * var(--k)); }
  #hearts { width: calc(81px * var(--k)); }
  #food { width: calc(81px * var(--k)); }
  #air { height: calc(9px * var(--k)); }
  #hotbar { display: flex; gap: 0; padding: 4px; background: rgba(20,20,20,.62); border: 2px solid #111; pointer-events: auto; }

  .slot { position: relative; width: var(--slot); height: var(--slot); box-sizing: border-box; flex: none; background: var(--slotbg); border: 2px solid; border-color: #373737 #fff #fff #373737; cursor: pointer; padding: 0; }
  #hotbar .slot { background: rgba(80,80,80,.55); border-color: #222 #666 #666 #222; }
  #hotbar .slot.sel { outline: 3px solid #fff; outline-offset: -2px; z-index: 1; background: rgba(120,120,120,.6); }
  .slot .ic { position: absolute; inset: 2px; background-size: contain; background-repeat: no-repeat; background-position: center; image-rendering: pixelated; pointer-events: none; }
  .slot .cnt { position: absolute; right: 2px; bottom: 0; font: 700 13px var(--font-data); color: #fff; text-shadow: 1px 1px 0 #3f3f3f; pointer-events: none; }
  .slot .dur { position: absolute; left: 3px; right: 3px; bottom: 2px; height: 3px; background: #000; pointer-events: none; }
  .slot .dur i { display: block; height: 100%; }
  .slot .num { position: absolute; left: 3px; top: 0; font: 700 10px var(--font-data); color: rgba(255,255,255,.6); pointer-events: none; }
  .slot:hover { filter: brightness(1.15); }
  .slot.disabled { opacity: .5; cursor: not-allowed; }

  #mine { left: 50%; top: calc(50% + 24px); width: 64px; height: 6px; transform: translateX(-50%); background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.7); }
  #mine div { height: 100%; width: 0; background: var(--gold); }
  #hurt { left: 0; top: 0; width: 100%; height: 100%; opacity: 0; transition: opacity .4s; background: radial-gradient(ellipse at center, rgba(200,20,20,0) 45%, rgba(200,20,20,.75) 100%); }
  #water { left: 0; top: 0; width: 100%; height: 100%; background: rgba(30,70,170,.42); }

  #hand { right: 7vw; bottom: -2vmin; width: 22vmin; height: 22vmin; background-size: contain; background-repeat: no-repeat; background-position: center; image-rendering: pixelated; transform: rotate(-18deg); transform-origin: 80% 100%; }
  #hand.swing { animation: swing .28s ease-out; }
  @keyframes swing { 0% { transform: rotate(-18deg); } 40% { transform: rotate(-62deg) translate(-6vmin, -4vmin); } 100% { transform: rotate(-18deg); } }

  #jump { position: absolute; left: 14px; bottom: calc(86px + env(safe-area-inset-bottom, 0px)); min-width: 86px; padding: 12px 14px; cursor: pointer; touch-action: none; font: 700 15px var(--font-display); color: var(--ink); background: rgba(20,32,43,.82); border: 2px solid var(--line); border-radius: 6px; }
  #jump small { display: block; font: 700 10px var(--font-data); color: var(--ink-dim); }
  #jump.down { border-color: var(--gold); box-shadow: 0 0 0 2px var(--gold) inset; }
  #jump:focus-visible, .btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  #chat { left: 14px; bottom: calc(158px + env(safe-area-inset-bottom, 0px)); max-width: min(70vw, 480px); font: 13px/1.4 var(--font-data); }
  #chat div { background: rgba(0,0,0,.5); padding: 2px 8px; margin-top: 2px; transition: opacity 1s; }
  #chatin { position: absolute; left: 14px; right: 14px; bottom: calc(10px + env(safe-area-inset-bottom, 0px)); box-sizing: border-box; padding: 8px 10px; font: 14px var(--font-data); color: #fff; background: rgba(0,0,0,.7); border: 2px solid #aaa; outline: none; }

  #inv, #overlay, #death { position: absolute; inset: 0; display: grid; place-items: center; padding: 12px; box-sizing: border-box; }
  #inv { background: rgba(0,0,0,.55); overflow: auto; }
  .win { background: var(--panel); border: 3px solid; border-color: #fff #555 #555 #fff; outline: 2px solid #000; padding: 12px; color: var(--txt); display: flex; flex-direction: column; gap: 8px; max-width: 100%; box-sizing: border-box; }
  .win h3 { margin: 0; font: 700 14px var(--font-display); color: var(--txt); }
  .grid9 { display: grid; grid-template-columns: repeat(9, var(--slot)); }
  .gridc { display: grid; }
  .craftrow { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .arrow { width: 34px; height: 22px; background: #8b8b8b; clip-path: polygon(0 30%, 55% 30%, 55% 0, 100% 50%, 55% 100%, 55% 70%, 0 70%); position: relative; }
  .arrow i { position: absolute; left: 0; top: 0; bottom: 0; background: #3c9a3c; width: 0; }
  .flame { width: 20px; height: 20px; background: #8b8b8b; clip-path: polygon(50% 0, 85% 45%, 75% 100%, 25% 100%, 15% 45%); position: relative; }
  .flame i { position: absolute; left: 0; right: 0; bottom: 0; background: #f08a1c; height: 0; }
  .pal { max-height: 210px; overflow: auto; border: 2px solid #555; background: #8b8b8b; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  #cursoritem { position: fixed; left: 0; top: 0; width: var(--slot); height: var(--slot); pointer-events: none; z-index: 50; }
  #cursoritem .slot { background: none; border: 0; }
  #tip { position: fixed; z-index: 60; pointer-events: none; padding: 4px 8px; font: 13px var(--font-data); color: #fff; background: rgba(16,0,16,.92); border: 2px solid #28007f; white-space: nowrap; }

  #overlay { background: rgba(10,18,26,.62); backdrop-filter: blur(3px); overflow: auto; }
  #death { background: rgba(80,0,0,.6); }
  .card { width: min(100%, 560px); box-sizing: border-box; padding: 22px; background: var(--night); border: 3px solid var(--line); border-radius: 6px; box-shadow: 0 6px 0 rgba(0,0,0,.4); }
  .card h1 { margin: 0 0 4px; font: 700 clamp(34px, 9vw, 50px)/1 var(--font-display); letter-spacing: 1px; text-wrap: balance; color: var(--grass); text-shadow: 0 4px 0 #2d5a1c; }
  .card h1.dead { color: #d94a4a; text-shadow: 0 4px 0 #6b1d1d; }
  .card p.sub { margin: 0 0 14px; color: var(--ink-dim); font-size: 14px; }
  .keys { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 0 0 16px; font-size: 13px; }
  .keys dt { font: 12px var(--font-data); color: var(--gold); white-space: nowrap; align-self: center; }
  .keys dd { margin: 0; min-width: 0; }
  .btn { font: 700 16px var(--font-display); letter-spacing: .5px; cursor: pointer; padding: 10px 18px; border-radius: 4px; border: 2px solid var(--line); background: #0d151d; color: var(--ink); }
  .btn.main { background: var(--grass); border-color: #2d5a1c; color: #0b1a05; flex: 1 1 140px; font-size: 18px; }
  .btn.mode.on { border-color: var(--gold); color: var(--gold); }
  .btn:hover { filter: brightness(1.12); }
  .modes { margin-bottom: 8px; } .modes .btn { flex: 1 1 0; }
  .modehelp { margin: 0 0 14px; font-size: 13px; color: var(--ink-dim); min-height: 2.6em; }
  #msg { margin: 12px 0 0; font-size: 13px; color: var(--ink-dim); min-height: 1em; }
  @media (max-width: 560px) { :root { --k: 1.4; } #hint { display: none; } }
</style>
</head>
<body>
<div id="app">
  <canvas id="view" tabindex="0"></canvas>
  <div class="hud" id="water" hidden></div>
  <div class="hud" id="hurt"></div>
  <div class="hud" id="hand"></div>
  <div class="hud" id="cross" aria-hidden="true"></div>
  <div class="hud" id="info" hidden></div>
  <div class="hud" id="hint"></div>
  <div class="hud" id="mine" hidden><div></div></div>
  <div class="hud" id="chat"></div>

  <div id="bottom">
    <div id="itemname"></div>
    <div id="stats">
      <canvas id="hearts" width="81" height="9" aria-label="Points de vie"></canvas>
      <canvas id="food" width="81" height="9" aria-label="Faim"></canvas>
    </div>
    <div id="hotbar" role="toolbar" aria-label="Barre d'objets"></div>
  </div>

  <button id="jump" type="button" aria-label="Sauter (Espace)">Sauter<small>ESPACE</small></button>
  <input id="chatin" type="text" maxlength="120" autocomplete="off" spellcheck="false" hidden>

  <div id="inv" hidden></div>
  <div id="cursoritem" hidden></div>
  <div id="tip" hidden></div>

  <div id="death" hidden>
    <div class="card">
      <h1 class="dead">Tu es mort</h1>
      <p class="sub" id="deathmsg">Ton inventaire est conservé.</p>
      <div class="row"><button class="btn main" id="respawn" type="button">Réapparaître</button></div>
    </div>
  </div>

  <div id="overlay">
    <div class="card">
      <h1>Mini Craft</h1>
      <p class="sub">Un petit monde en blocs à explorer, miner, fabriquer et défendre.</p>
      <dl class="keys">
        <dt>W A S D / Z Q S D</dt><dd>Se déplacer</dd>
        <dt>Espace</dt><dd>Sauter, nager. Créatif: 2 fois pour voler</dd>
        <dt>Maj / Ctrl</dt><dd>Se faufiler (descendre en vol) / Sprinter</dd>
        <dt>Clic gauche</dt><dd>Casser (maintenir) ou attaquer</dd>
        <dt>Clic droit</dt><dd>Poser, utiliser, manger, tirer à l'arc</dd>
        <dt>1 à 9 / molette</dt><dd>Choisir l'objet</dd>
        <dt>E</dt><dd>Inventaire et fabrication 2x2</dd>
        <dt>T ou /</dt><dd>Chat et commandes (/help)</dd>
        <dt>F3 / Échap</dt><dd>Infos de debug / Pause</dd>
      </dl>
      <div class="row modes" role="radiogroup" aria-label="Mode de jeu">
        <button class="btn mode on" type="button" role="radio" aria-checked="true" data-mode="creatif">Créatif</button>
        <button class="btn mode" type="button" role="radio" aria-checked="false" data-mode="survie">Survie</button>
      </div>
      <p class="modehelp" id="modehelp"></p>
      <div class="row">
        <button class="btn main" id="play" type="button">Jouer</button>
        <button class="btn" id="fresh" type="button">Nouveau monde</button>
      </div>
      <p id="msg"></p>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function () {
  var msgEl = document.getElementById("msg");
  if (typeof THREE === "undefined") { msgEl.textContent = "Impossible de charger le moteur 3D. Vérifie ta connexion et recharge la page."; return; }
  /* ================= DONNÉES: textures, blocs, objets, recettes ================= */
  var TILE = 16;
  var TEXN = ['grass_top','grass_side','dirt','stone','cobble','sand','log_top','log_side','leaves','planks',
    'craft_top','craft_side','craft_front','furnace_top','furnace_side','furnace_front','coal_ore','iron_ore','diamond_ore','glass','bedrock','water'];
  var T = {}; TEXN.forEach(function (n, i) { T[n] = i; });
  var atlasCanvas = document.createElement("canvas");
  atlasCanvas.width = TILE * TEXN.length; atlasCanvas.height = TILE;
  var actx = atlasCanvas.getContext("2d");

  function rnd(i, j, t) {
    var h = Math.imul(i + 1, 73856093) ^ Math.imul(j + 1, 19349663) ^ Math.imul(t + 1, 83492791);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
  }
  function cl(v) { return v < 0 ? 0 : v > 255 ? 255 : v | 0; }
  function mul(c, f) { return [cl(c[0] * f), cl(c[1] * f), cl(c[2] * f)]; }
  function rgb(c) { return "rgb(" + c[0] + "," + c[1] + "," + c[2] + ")"; }
  function mkC(w, h) { var c = document.createElement("canvas"); c.width = w; c.height = h; return c; }

  function mk(name, fn) {
    var t = T[name], d = actx.createImageData(TILE, TILE);
    for (var j = 0; j < TILE; j++) for (var i = 0; i < TILE; i++) {
      var c = fn(i, j, rnd(i, j, t), rnd(i + 31, j + 17, t + 99));
      var o = (j * TILE + i) * 4;
      d.data[o] = c[0]; d.data[o + 1] = c[1]; d.data[o + 2] = c[2]; d.data[o + 3] = c.length > 3 ? c[3] : 255;
    }
    actx.putImageData(d, t * TILE, 0);
  }

  var C_STONE = [125, 125, 125], C_DIRT = [134, 96, 67], C_GRASS = [92, 150, 52], C_PLANK = [162, 130, 78], C_BARK = [102, 81, 50], C_BAND = [110, 72, 38];
  function stoneC(r, r2) { var f = 0.82 + r * 0.26; if (r2 > 0.88) f += 0.1; if (r2 < 0.08) f -= 0.14; return mul(C_STONE, f); }
  function cobbleFn(i, j, r) {
    var row = Math.floor(j / 4), off = (row % 2) ? 3 : 0, cx = Math.floor((i + off) / 6);
    var f = 0.62 + rnd(cx, row, 3) * 0.5 + r * 0.12;
    if ((i + off) % 6 === 5 || j % 4 === 3) f = 0.42 + r * 0.1;
    return mul(C_STONE, f);
  }
  mk("stone", function (i, j, r, r2) { return stoneC(r, r2); });
  mk("cobble", cobbleFn);
  mk("dirt", function (i, j, r, r2) { var f = 0.82 + r * 0.3; if (r2 > 0.9) f += 0.14; if (r2 < 0.07) f -= 0.2; return mul(C_DIRT, f); });
  mk("grass_top", function (i, j, r, r2) { var f = 0.8 + r * 0.36; if (r2 > 0.92) f += 0.12; return mul(C_GRASS, f); });
  mk("grass_side", function (i, j, r, r2) {
    var depth = 3 + (rnd(i, 5, 8) > 0.5 ? 1 : 0);
    if (j < depth) return mul(C_GRASS, 0.8 + r * 0.36);
    var f = 0.82 + r * 0.3; if (r2 > 0.9) f += 0.14; if (r2 < 0.07) f -= 0.2;
    return mul(C_DIRT, f);
  });
  mk("sand", function (i, j, r, r2) { return mul([219, 207, 163], 0.93 + r * 0.12 + (r2 > 0.93 ? 0.05 : 0)); });
  mk("log_top", function (i, j, r) {
    var d = Math.max(Math.abs(i - 7.5), Math.abs(j - 7.5));
    if (d > 6) return mul(C_BARK, 0.85 + r * 0.25);
    return mul(Math.floor(d) % 2 ? [158, 122, 70] : [182, 146, 92], 0.92 + r * 0.14);
  });
  mk("log_side", function (i, j, r) { return mul(C_BARK, 0.7 + rnd(i, 0, 11) * 0.35 + r * 0.12); });
  mk("leaves", function (i, j, r, r2) { if (r2 < 0.2) return [0, 0, 0, 0]; return mul([62, 142, 42], 0.55 + r * 0.7); });
  mk("planks", function (i, j, r) {
    var row = Math.floor(j / 4), f = 0.9 + rnd(row, 1, 5) * 0.14 + r * 0.1;
    if (j % 4 === 3) f = 0.7;
    else if (i === (row * 5 + 3) % 16) f = 0.72;
    return mul(C_PLANK, f);
  });
  mk("craft_top", function (i, j, r) {
    if (i < 2 || j < 2 || i > 13 || j > 13) return mul(C_BAND, 0.9 + r * 0.15);
    if (i === 7 || i === 8 || j === 7 || j === 8) return mul([88, 58, 30], 0.95 + r * 0.1);
    return mul(C_PLANK, 0.9 + r * 0.2);
  });
  mk("craft_side", function (i, j, r) {
    if (j < 3) return mul(C_BAND, 0.9 + r * 0.15);
    return mul(C_PLANK, (i % 8 === 0 ? 0.72 : 0.88) + r * 0.2);
  });
  mk("craft_front", function (i, j, r) {
    if (j < 3) return mul(C_BAND, 0.9 + r * 0.15);
    if (j >= 6 && j <= 7 && i >= 2 && i <= 7) return mul([190, 190, 195], 0.9 + r * 0.1);
    if (j >= 8 && j <= 11 && (i === 4 || i === 5)) return mul([90, 60, 34], 1);
    if (i >= 9 && i <= 13 && j >= 6 && j <= 8) return mul([130, 130, 135], 1);
    return mul(C_PLANK, 0.85 + r * 0.2);
  });
  mk("furnace_top", function (i, j, r) { return mul(C_STONE, 0.7 + r * 0.2); });
  mk("furnace_side", cobbleFn);
  mk("furnace_front", function (i, j, r) {
    if (i >= 3 && i <= 12 && j >= 8 && j <= 13) return j === 13 ? [90, 40, 18] : [30, 30, 32];
    if (i >= 5 && i <= 10 && j >= 3 && j <= 4) return [28, 28, 30];
    return cobbleFn(i, j, r);
  });
  function ore(name, col, hi) {
    var blobs = [[2, 2], [8, 1], [11, 6], [4, 7], [9, 11], [2, 12]];
    mk(name, function (i, j, r, r2) {
      for (var b = 0; b < blobs.length; b++) {
        var dx = i - blobs[b][0], dy = j - blobs[b][1];
        if (dx >= 0 && dx < 3 && dy >= 0 && dy < 2 && !(dx === 2 && dy === 1)) return mul(col, (hi && r > 0.7) ? 1.25 : 0.85 + r * 0.3);
      }
      return stoneC(r, r2);
    });
  }
  ore("coal_ore", [30, 30, 32]); ore("iron_ore", [214, 172, 140]); ore("diamond_ore", [92, 232, 224], true);
  mk("glass", function (i, j) {
    if (i === 0 || j === 0 || i === 15 || j === 15) return [190, 225, 235, 255];
    if ((i === 3 && j >= 3 && j <= 6) || (j === 3 && i >= 3 && i <= 6)) return [255, 255, 255, 255];
    return [0, 0, 0, 0];
  });
  mk("bedrock", function (i, j, r) { return mul([100, 100, 104], 0.3 + r * 0.6); });
  mk("water", function (i, j, r) { return [40, 92 + ((r * 14) | 0), 205, 255]; });

  var atlas = new THREE.CanvasTexture(atlasCanvas);
  atlas.magFilter = THREE.NearestFilter; atlas.minFilter = THREE.NearestFilter; atlas.generateMipmaps = false;

  /* ---------- Blocs ---------- */
  var BL = [];
  function t3(top, bot, side) { return [T[side], T[side], T[bot], T[top], T[side], T[side]]; }
  function defB(id, key, name, tiles, o) {
    o = o || {};
    BL[id] = { id: id, key: key, name: name, tiles: tiles, h: o.h == null ? 1 : o.h, tool: o.tool || null, lvl: o.lvl || 0,
      drop: o.drop === undefined ? id : o.drop, trans: !!o.trans, liquid: !!o.liquid };
  }
  var GRASS = 1, DIRT = 2, STONE = 3, COBBLE = 4, SAND = 5, LOG = 6, LEAVES = 7, PLANKS = 8, CRAFT = 9, FURNACE = 10, COAL_ORE = 11, IRON_ORE = 12, DIAM_ORE = 13, GLASS = 14, BEDROCK = 15, WATER = 16;
  defB(1, "grass_block", "Bloc d'herbe", t3("grass_top", "dirt", "grass_side"), { h: 0.6, tool: "shovel", drop: 2 });
  defB(2, "dirt", "Terre", t3("dirt", "dirt", "dirt"), { h: 0.5, tool: "shovel" });
  defB(3, "stone", "Pierre", t3("stone", "stone", "stone"), { h: 1.5, tool: "pickaxe", lvl: 1, drop: 4 });
  defB(4, "cobblestone", "Pierre taillée", t3("cobble", "cobble", "cobble"), { h: 2, tool: "pickaxe", lvl: 1 });
  defB(5, "sand", "Sable", t3("sand", "sand", "sand"), { h: 0.5, tool: "shovel" });
  defB(6, "oak_log", "Bûche de chêne", t3("log_top", "log_top", "log_side"), { h: 2, tool: "axe" });
